# Copy to .env and fill in from your Supabase project (Project Settings > API).
# Only VITE_-prefixed variables are exposed to the browser bundle, which is why the
# anon key lives here and the service-role key must never appear in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature flags for screens still being built. Set to true in your own .env to see them.
VITE_FEATURE_VENUE_BLOCKS=false
VITE_FEATURE_VENUE_SUITABILITY=false
